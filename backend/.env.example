# Database
DATABASE_URL=postgresql+psycopg://docextractor_user:docextractor_pass@localhost:5432/docextractor

# Storage
STORAGE_DIR=./storage

# Upload validation
MAX_UPLOAD_SIZE_MB=10
ALLOWED_CONTENT_TYPES=["application/pdf","image/png","image/jpeg"]

# LLM (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=30
MAX_LLM_INPUT_CHARS=12000

# Extraction confidence heuristics
MIN_TEXT_CONFIDENCE=0.35
FIELD_FLAG_THRESHOLD=0.7
CROSS_FIELD_TOLERANCE=0.02

# CORS (frontend dev origin)
CORS_ORIGINS=["http://localhost:5173"]
